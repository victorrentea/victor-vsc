{
  "name": "victor-vsc",
  "publisher": "victorrentea",
  "displayName": "Victor VSC",
  "description": "IntelliJ-flavoured VS Code: expui icon theme, IntelliJ New UI colours, status-bar breadcrumb + problems + tools button, Markdown preview zoom, and a Claude terminal profile",
  "version": "0.0.61",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onTerminalProfile:victor-vsc.claude",
    "onCustomEditor:victor-vsc.pumlDiagram"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "intellij-expui",
        "label": "IntelliJ New UI (expui)",
        "path": "./intellij-icon-theme.json"
      }
    ],
    "markdown.previewScripts": [
      "./zoom.js",
      "./line-numbers.js"
    ],
    "markdown.previewStyles": [
      "./line-numbers.css"
    ],
    "icons": {
      "victor-flower": {
        "description": "Flower",
        "default": {
          "fontPath": "./icons/victor-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "victor-coins": {
        "description": "Two coins, overlapping on the diagonal",
        "default": {
          "fontPath": "./icons/victor-icons.woff",
          "fontCharacter": "\\E002"
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "victor-vsc.claude",
          "title": "Claude",
          "icon": "victor-flower"
        }
      ]
    },
    "configurationDefaults": {
      "java.configuration.updateBuildConfiguration": "automatic",
      "terminal.integrated.confirmOnKill": "always",
      "terminal.integrated.env.osx": {
        "NO_COLOR": null
      },
      "workbench.navigationControl.enabled": false,
      "workbench.editor.enablePreview": false,
      "workbench.editor.enablePreviewFromQuickOpen": false,
      "workbench.editor.enablePreviewFromCodeNavigation": false,
      "editor.inlayHints.enabled": "off",
      "workbench.browser.openLocalhostLinks": true,
      "[markdown]": {
        "editor.wordWrap": "off"
      },
      "[prompt]": {
        "editor.wordWrap": "off"
      },
      "[instructions]": {
        "editor.wordWrap": "off"
      },
      "[chatagent]": {
        "editor.wordWrap": "off"
      },
      "[skill]": {
        "editor.wordWrap": "off"
      },
      "workbench.colorCustomizations": {
        "[IntelliJ IDEA Islands Light]": {
          "titleBar.activeBackground": "#ECEDF0",
          "titleBar.inactiveBackground": "#ECEDF0",
          "activityBar.background": "#ECEDF0",
          "activityBar.activeBackground": "#D9D9DB",
          "activityBar.activeBorder": "#00000000",
          "activityBar.activeFocusBorder": "#00000000",
          "activityBar.foreground": "#6C707E",
          "activityBar.inactiveForeground": "#6C707E",
          "statusBar.background": "#ECEDF0",
          "sideBarSectionHeader.background": "#ECEDF0",
          "sideBarTitle.background": "#ECEDF0",
          "sideBar.background": "#FFFFFF",
          "editorGroupHeader.tabsBackground": "#FFFFFF",
          "panel.background": "#FFFFFF",
          "editor.background": "#FFFFFF",
          "sideBar.border": "#C3C8D2",
          "sideBarSectionHeader.border": "#DFE1E5",
          "activityBar.border": "#DFE1E5",
          "panel.border": "#DFE1E5",
          "editorGroup.border": "#C3C8D2",
          "editorGroupHeader.tabsBorder": "#DFE1E5",
          "statusBar.border": "#DFE1E5",
          "titleBar.border": "#DFE1E5",
          "symbolIcon.classForeground": "#3574F0",
          "symbolIcon.interfaceForeground": "#208A3C",
          "symbolIcon.enumeratorForeground": "#834DF0",
          "symbolIcon.enumeratorMemberForeground": "#834DF0",
          "symbolIcon.propertyForeground": "#834DF0",
          "symbolIcon.methodForeground": "#DB3B4B",
          "symbolIcon.functionForeground": "#DB3B4B",
          "symbolIcon.constructorForeground": "#DB3B4B",
          "symbolIcon.fieldForeground": "#E66D17",
          "symbolIcon.variableForeground": "#E66D17",
          "symbolIcon.constantForeground": "#E66D17",
          "symbolIcon.packageForeground": "#6C707E",
          "symbolIcon.namespaceForeground": "#6C707E",
          "symbolIcon.moduleForeground": "#6C707E",
          "editor.lineHighlightBackground": "#F5F8FE",
          "editor.lineHighlightBorder": "#00000000",
          "editor.wordHighlightBackground": "#EDEBFB",
          "editor.wordHighlightStrongBackground": "#EDEBFB",
          "editor.wordHighlightTextBackground": "#EDEBFB",
          "editor.selectionHighlightBackground": "#EDEBFB",
          "sash.hoverBorder": "#3574F0",
          "list.errorForeground": "#000000",
          "list.warningForeground": "#000000",
          "gitDecoration.modifiedResourceForeground": "#0032A0",
          "gitDecoration.addedResourceForeground": "#0A7700",
          "gitDecoration.untrackedResourceForeground": "#993300",
          "gitDecoration.deletedResourceForeground": "#616161",
          "gitDecoration.ignoredResourceForeground": "#727238",
          "gitDecoration.renamedResourceForeground": "#007C7C",
          "gitDecoration.conflictingResourceForeground": "#FF0000",
          "gitDecoration.stageModifiedResourceForeground": "#0032A0",
          "gitDecoration.stageDeletedResourceForeground": "#616161"
        },
        "[IntelliJ IDEA Islands Dark]": {
          "titleBar.activeBackground": "#2B2D30",
          "titleBar.inactiveBackground": "#2B2D30",
          "activityBar.background": "#2B2D30",
          "activityBar.activeBackground": "#43454A",
          "activityBar.activeBorder": "#00000000",
          "activityBar.activeFocusBorder": "#00000000",
          "activityBar.foreground": "#CED0D6",
          "activityBar.inactiveForeground": "#CED0D6",
          "sideBar.background": "#1E1F22",
          "sideBarSectionHeader.background": "#1E1F22",
          "sideBarTitle.background": "#1E1F22",
          "panel.background": "#1E1F22",
          "terminal.background": "#1E1F22",
          "statusBar.background": "#2B2D30",
          "editor.background": "#1E1F22",
          "sideBar.border": "#393B40",
          "sideBarSectionHeader.border": "#393B40",
          "activityBar.border": "#393B40",
          "panel.border": "#393B40",
          "editorGroup.border": "#393B40",
          "editorGroupHeader.tabsBorder": "#393B40",
          "statusBar.border": "#393B40",
          "titleBar.border": "#393B40",
          "list.errorForeground": "#BCBEC4",
          "list.warningForeground": "#BCBEC4",
          "symbolIcon.classForeground": "#548AF7",
          "symbolIcon.interfaceForeground": "#57965C",
          "symbolIcon.enumeratorForeground": "#A571E6",
          "symbolIcon.enumeratorMemberForeground": "#A571E6",
          "symbolIcon.propertyForeground": "#B589EC",
          "symbolIcon.methodForeground": "#DB5C5C",
          "symbolIcon.functionForeground": "#DB5C5C",
          "symbolIcon.constructorForeground": "#DB5C5C",
          "symbolIcon.fieldForeground": "#C77D55",
          "symbolIcon.variableForeground": "#C77D55",
          "symbolIcon.constantForeground": "#C77D55",
          "symbolIcon.packageForeground": "#CED0D6",
          "symbolIcon.namespaceForeground": "#CED0D6",
          "symbolIcon.moduleForeground": "#CED0D6",
          "sideBar.foreground": "#D0D2D8"
        }
      },
      "workbench.fontAliasing": "antialiased",
      "terminal.integrated.fontWeightBold": "800",
      "zenMode.hideActivityBar": false,
      "zenMode.hideLineNumbers": false,
      "zenMode.centerLayout": false,
      "editor.stickyScroll.enabled": true,
      "editor.stickyScroll.maxLineCount": 8,
      "editor.stickyScroll.defaultModel": "outlineModel",
      "editor.stickyScroll.scrollWithEditor": true,
      "gpt-token-counter-live.statusBarDisplayTemplate": "{count} tok ({family})"
    },
    "customEditors": [
      {
        "viewType": "victor-vsc.pumlDiagram",
        "displayName": "PlantUML Diagram",
        "selector": [
          {
            "filenamePattern": "*.{puml,plantuml,iuml,wsd,pu}"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "victor-vsc.togglePumlView",
        "title": "Preview Diagram",
        "category": "PlantUML",
        "icon": "$(open-preview)"
      },
      {
        "command": "victor-vsc.noop",
        "title": "Do Nothing",
        "category": "victor-vsc"
      },
      {
        "command": "victor-vsc.copyGitHubLink",
        "title": "Copy GitHub Link",
        "category": "victor-vsc"
      },
      {
        "command": "victor-vsc.runFileTests",
        "title": "Run Tests in Current File",
        "category": "victor-vsc",
        "icon": "$(run-all)"
      },
      {
        "command": "victor-vsc.debugFileTests",
        "title": "Debug Tests in Current File",
        "category": "victor-vsc",
        "icon": "$(debug-alt)"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.terminal.new",
        "key": "ctrl+n",
        "when": "terminalFocus"
      },
      {
        "command": "workbench.action.terminal.new",
        "key": "cmd+t",
        "when": "terminalFocus"
      },
      {
        "command": "workbench.action.terminal.new",
        "key": "cmd+n",
        "when": "terminalFocus"
      },
      {
        "command": "workbench.action.terminal.kill",
        "key": "cmd+w",
        "when": "terminalFocus"
      },
      {
        "command": "workbench.action.toggleMaximizedPanel",
        "key": "f12",
        "when": "terminalFocus"
      },
      {
        "command": "victor-vsc.noop",
        "key": "cmd+alt+left"
      },
      {
        "command": "victor-vsc.noop",
        "key": "cmd+alt+right"
      },
      {
        "command": "editor.action.toggleWordWrap",
        "key": "alt+`",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "victor-vsc.noop",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "victor-vsc.copyGitHubLink",
          "group": "6_copypath@3"
        }
      ],
      "editor/title": [
        {
          "command": "victor-vsc.runFileTests",
          "group": "navigation@0",
          "when": "resourceExtname == .feature || resourceFilename =~ /\\.(spec|test)\\.[jt]sx?$/"
        },
        {
          "command": "victor-vsc.debugFileTests",
          "group": "navigation@0",
          "when": "resourceFilename =~ /\\.(spec|test)\\.[jt]sx?$/"
        },
        {
          "command": "victor-vsc.togglePumlView",
          "group": "navigation@1",
          "when": "resourceExtname == .puml || resourceExtname == .plantuml || resourceExtname == .iuml || resourceExtname == .wsd || resourceExtname == .pu"
        }
      ]
    },
    "configuration": {
      "title": "Victor VSC",
      "properties": {
        "victorVsc.plantumlPath": {
          "type": "string",
          "default": "",
          "description": "Path to the plantuml binary. Empty = try /opt/homebrew/bin/plantuml, /usr/local/bin/plantuml, then PATH."
        },
        "victorVsc.reportOpenFileToAddon": {
          "type": "boolean",
          "default": true,
          "description": "Report the file you dwell on (5s, focused window) to Victor Addons, like the live-coding IntelliJ plugin does. Only ever posts to the configured localhost URL; goes quiet if nothing answers."
        },
        "victorVsc.addonReportUrl": {
          "type": "string",
          "default": "http://127.0.0.1:55123/intellij/file-opened",
          "description": "Where to report the actively open file. Same endpoint as the IntelliJ plugin: the payload is identical and the add-on does not care which IDE sent it."
        }
      }
    }
  },
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorrentea/victor-vsc.git"
  }
}
